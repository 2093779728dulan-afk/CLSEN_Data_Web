# Copy this file to .env for local development.
# Do not put credentials or other secrets in this tracked example.
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO

# Release/build-scoped product analytics mode. The backend and frontend build
# must receive the same exact value; request-, cookie-, user-, SKU-, and row-
# level overrides are intentionally unsupported.
APP_PRODUCT_ANALYTICS_SOURCE=p0_catalog
VITE_PRODUCT_ANALYTICS_SOURCE=p0_catalog

# Required in production and for stable local login sessions across restarts.
# Generate at least 32 unpredictable characters and keep this value only in the
# protected .env file or deployment secret store. init-database.ps1 creates it.
APP_SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
# Omit in local development; set true behind HTTPS in a server environment.
# APP_SESSION_COOKIE_SECURE=true

# Comma-separated, explicit browser origins. Wildcards are intentionally not used.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# File storage must use an explicit absolute path in a protected, Git-ignored root.
# Windows local example below; for Linux use a path such as /srv/clsen-data/raw.
# Windows storage must be on a local fixed NTFS volume, not a network or synced path.
# init-database.ps1 protects this default root; protect and verify any custom root.
APP_STORAGE_ROOT=D:/CLSEN_Data_Web/data/raw
APP_STORAGE_MAX_UPLOAD_BYTES=104857600
APP_STORAGE_LEASE_TTL_SECONDS=900
APP_STORAGE_LEASE_RENEW_INTERVAL_SECONDS=300
APP_STORAGE_ORPHAN_AGE_SECONDS=86400

# Percent-encode reserved characters in passwords before placing them in URLs.
# Keep real values only in the untracked .env file or a deployment secret store.
APP_DATABASE_URL=mysql+pymysql://clsen_app:CHANGE_ME@127.0.0.1:3306/clsen_data?charset=utf8mb4
APP_MIGRATION_DATABASE_URL=mysql+pymysql://clsen_migrator:CHANGE_ME@127.0.0.1:3306/clsen_data?charset=utf8mb4
APP_BACKUP_DATABASE_URL=mysql+pymysql://clsen_backup:CHANGE_ME@127.0.0.1:3306/clsen_data?charset=utf8mb4
APP_TEST_DATABASE_URL=mysql+pymysql://clsen_migrator:CHANGE_ME@127.0.0.1:3306/clsen_data_test?charset=utf8mb4
APP_TEST_RUNTIME_DATABASE_URL=mysql+pymysql://clsen_app:CHANGE_ME@127.0.0.1:3306/clsen_data_test?charset=utf8mb4
APP_TEST_BACKUP_DATABASE_URL=mysql+pymysql://clsen_backup:CHANGE_ME@127.0.0.1:3306/clsen_data_test?charset=utf8mb4
APP_MAINTENANCE_WRITE_LOCK_TIMEOUT_SECONDS=30
# Readiness becomes degraded only after consecutive probes observe the backup
# write barrier for this many seconds; ordinary short write transactions are normal.
APP_MAINTENANCE_LOCK_WARNING_SECONDS=120
