{
  "name": "clsen-data-web-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test": "vitest",
    "test:tokens": "node --experimental-strip-types scripts/check-design-system-tokens.ts",
    "test:a11y": "playwright test --config playwright.storybook.config.ts tests/storybook/a11y.spec.ts",
    "test:e2e": "playwright test",
    "test:e2e:baseline": "playwright test --config playwright.baseline.config.ts",
    "test:visual": "playwright test --config playwright.storybook.config.ts tests/storybook/visual.spec.ts",
    "test:visual:update": "node --experimental-strip-types scripts/update-storybook-visual-baselines.ts",
    "baseline:bundle": "node scripts/project-optimization-bundle-baseline.mjs",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "4.3.5",
    "@hugeicons/react": "1.1.10",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-toast": "1.2.23",
    "@radix-ui/react-tooltip": "1.2.16",
    "lucide-react": "1.41.0",
    "motion": "14.0.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "7.8.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.34.0",
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "eslint": "9.34.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.3.0",
    "jsdom": "26.1.0",
    "storybook": "10.6.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.41.0",
    "vite": "7.1.3",
    "vitest": "3.2.4"
  },
  "packageManager": "pnpm@11.16.0"
}
